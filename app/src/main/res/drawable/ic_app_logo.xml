    <path
        android:pathData="M40,15 v7 M66,15 v7"
        android:strokeWidth="3.6"
        android:strokeColor="#0F172A"
        android:strokeLineCap="round" />

    <!-- 5. PLANNER HEADER LINES -->
    <path
        android:pathData="M36,28 h34"
        android:strokeWidth="3"
        android:strokeColor="#0F172A"
        android:strokeLineCap="round" />
    <path
        android:pathData="M38,34 h30"
        android:strokeWidth="2.2"
        android:strokeColor="#334155"
        android:strokeLineCap="round" />

