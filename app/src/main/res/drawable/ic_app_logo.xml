<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- 1. SQUIRCLE EMBOSSED BACKGROUND (Rich emerald teal gradient) -->
    <path
        android:pathData="M24,4 h72 a20,20 0 0,1 20,20 v72 a20,20 0 0,1 -20,20 h-72 a20,20 0 0,1 -20,-20 v-72 a20,20 0 0,1 20,-20 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="10"
                android:endX="100"
                android:endY="110">
                <item android:offset="0.0" android:color="#146A52" />
                <item android:offset="0.5" android:color="#0B4B39" />
                <item android:offset="1.0" android:color="#03271E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Squircle Rim Glow -->
    <path
        android:pathData="M24,4 h72 a20,20 0 0,1 20,20 v72 a20,20 0 0,1 -20,20 h-72 a20,20 0 0,1 -20,-20 v-72 a20,20 0 0,1 20,-20 z"
        android:strokeWidth="1.2"
        android:strokeColor="#25FFFFFF"
        android:fillColor="#00000000" />

    <!-- 2. NOTEPAD / PLANNER SHADOW -->
    <path
        android:pathData="M31,21 h48 a6,6 0 0,1 6,6 v52 a6,6 0 0,1 -6,6 h-48 a6,6 0 0,1 -6,-6 v-52 a6,6 0 0,1 6,-6 z"
