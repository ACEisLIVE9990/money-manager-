    <path
        android:pathData="M95,35 l2.5,-2.5 M98,42 l2.5,-0.6 M93,30 l1.2,-2.4"
        android:strokeWidth="1.4"
        android:strokeColor="#FEF08A"
        android:strokeLineCap="round" />

    <!-- 11. BOTTOM ACCENT SLOGAN SMILE LINE -->
    <path
        android:pathData="M44,103 Q60,100 76,103"
        android:strokeWidth="2.8"
        android:strokeColor="#4ADE80"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />
</vector>
