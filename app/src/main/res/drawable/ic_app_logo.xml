        android:pathData="M34,58 h7 a1.8,1.8 0 0,1 1.8,1.8 v3.5 a1.8,1.8 0 0,1 -1.8,1.8 h-7 a1.8,1.8 0 0,1 -1.8,-1.8 v-3.5 a1.8,1.8 0 0,1 1.8,-1.8 z"
